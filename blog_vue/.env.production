# ===== 基础前缀 =====
VITE_API=/api/v1

# ===== USER 用户模块 =====
## POST 用户注册
VITE_API_USER_SIGNUP=/user/signup
## POST 用户登录
VITE_API_USER_LOGIN=/user/login
## POST 上传用户头像到 MinIO /GET 获取用户头像临时访问url { objectname }
VITE_API_USER_MINIO=/user/minio


# ===== ART 文章模块 =====
## POST 添加文章 / GET 查询文章列表 / DELETE 删除文章 {artid}
VITE_API_ART=/art
## POST 上传文章封面到 MinIO / GET 获取封面访问 url
VITE_API_ART_MINIO=/art/minio

# ===== CAT 分类模块 =====
## POST 添加分类 / GET 查询分类列表
VITE_API_CAT=/cat

# ===== TAG 标签模块 =====
## POST 添加标签 / GET 查询标签列表
VITE_API_TAG=/tag